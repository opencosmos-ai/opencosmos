# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
.next/
out/
dist/
build/

# Environment variables
.env
.env*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Knowledge staging (raw files before curation)
knowledge/incoming/

# Misc
*.tsbuildinfo

# Regenerated by Next on every dev/build; tracking it only produces drift
next-env.d.ts
.cache/

# Quote validation batch inputs are regenerable from pending.jsonl; only the
# agent outputs (the audit trail) are worth versioning.
knowledge/quotes/_source/validation-batches/*.input.json

# Vendored source material — the fetched wikitext and OCR the importer ran from.
knowledge/iching/sources/.cache/

# Corpus and Cosmo, fetched from their repositories at build time
.content/

# Vercel CLI project link
.vercel/

# Cosmo's constitutional layer lives in opencosmos-ai/cosmo and is fetched into
# .content/cosmo at build time. The one file deliberately NOT published
# there is Shalom's personal relational context: it is supplied to deployments
# through the COSMO_SHALOM_CONTEXT environment variable, and kept here only as
# an untracked local copy so `next dev` behaves the same as production.
packages/ai/

# Playwright MCP output (screenshots, snapshots, console logs)
.playwright-mcp/
