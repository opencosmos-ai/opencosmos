{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "ANTHROPIC_API_KEY",
    "COSMO_SYSTEM_PROMPT",
    "COSMO_LESSONS",
    "COSMO_EXEMPLARS",
    "COSMO_FREE_MONTHLY_TOKEN_CAP",
    "COSMO_ADMIN_SECRET",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_WEBHOOK_SECRET",
    "WORKOS_COOKIE_PASSWORD",
    "WORKOS_REDIRECT_URI",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET_KEY",
    "COSMO_SHALOM_CONTEXT",
    "XENSO_MODULE",
    "CONTENT_TOKEN",
    "CONTENT_REF",
    "KNOWLEDGE_REPO",
    "COSMO_REPO",
    "KNOWLEDGE_LOCAL_DIR",
    "COSMO_LOCAL_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
